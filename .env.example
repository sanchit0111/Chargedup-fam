# Copy to .env and fill in. Never commit .env (see .gitignore).

# Google Earth Engine service account — the whole JSON key file's contents, as ONE line
# (no real newlines; the private_key field's \n escapes stay as literal backslash-n text).
# See execution.md §1 for how to create one.
GEE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# LLM provider for src/llm/narrative.py — "bedrock" (default), "gemini", or "anthropic".
LLM_PROVIDER=bedrock

# bedrock: uses an assumed IAM role via the AWS CLI credential chain (~/.aws/config profile),
# not a raw API key. Requires bedrock:InvokeModel on the given inference-profile ID.
AWS_PROFILE=bedrock-role
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5

# gemini: alternate provider (LLM_PROVIDER=gemini).
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# anthropic: direct API alternate provider (LLM_PROVIDER=anthropic). Console: console.anthropic.com
ANTHROPIC_API_KEY=

# data.gov.in → register → API key (used for the Agmarknet mandi-price resource).
# A public demo key that works against this specific resource is documented in
# data/raw/PHASE1_FINDINGS.md — fine for hackathon use, get your own key before anything further.
DATA_GOV_IN_API_KEY=
